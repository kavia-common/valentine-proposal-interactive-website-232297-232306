<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#2563EB" stop-opacity="0.20"/>
      <stop offset="55%" stop-color="#F9FAFB" stop-opacity="1"/>
      <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.18"/>
    </linearGradient>
    <linearGradient id="card" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.92"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.82"/>
    </linearGradient>
  </defs>

  <rect width="1200" height="800" fill="url(#bg)"/>
  <circle cx="220" cy="180" r="140" fill="#2563EB" opacity="0.12"/>
  <circle cx="1000" cy="220" r="170" fill="#F59E0B" opacity="0.12"/>
  <circle cx="360" cy="680" r="190" fill="#2563EB" opacity="0.10"/>

  <rect x="120" y="140" width="960" height="520" rx="28" fill="url(#card)" stroke="#111827" stroke-opacity="0.08"/>
  <text x="600" y="325" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="46" fill="#111827">
    Couple Photo 1
  </text>
  <text x="600" y="385" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-weight="600" font-size="22" fill="#6B7280">
    TODO: Replace this placeholder with your real photo.
  </text>

  <text x="600" y="575" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-weight="700" font-size="18" fill="#2563EB">
    Ocean Professional theme • #2563EB / #F59E0B
  </text>
</svg>
